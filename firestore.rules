rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/appdata/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/incoming_orders/{orderId} {
      // Publik: siapa saja boleh checkout (create) dan lihat status pesanannya sendiri
      // via link unik (read). Cuma Owner yang bisa update (konfirmasi/tolak/progres
      // pengiriman) atau menghapus.
      allow create: if true;
      allow read: if true;
      allow update, delete: if request.auth != null && request.auth.uid == uid;
    }

    match /users/{uid}/public_products/{productId} {
      // Publik: siapa saja boleh lihat produk yang ditampilkan di Etalase.
      // Cuma Owner yang bisa menambah/ubah/hapus (lewat tab Etalase).
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
